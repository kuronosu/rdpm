#!/usr/bin/env bash
# Gestor de conexiones RDP (FreeRDP 3)
#
# Registro de máquinas: ~/.config/rdpm/machines.json
# Contraseñas:          llavero del sistema (gnome-keyring, vía secret-tool)
#
# Uso:
#   rdpm                    menú interactivo
#   rdpm connect <nombre>   conectar a una máquina registrada
#   rdpm last               conectar a la última máquina usada
#   rdpm sessions           sesiones activas
#   rdpm status             estado en JSON (usado por la barra)
#   rdpm add | edit <nombre> | remove <nombre> | list

set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rdpm"
DB="$CONFIG_DIR/machines.json"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rdpm"
LAST="$STATE_DIR/last"
KEYRING_SERVICE="rdpm"
IN_MENU=""

# Sin procesos extra cuando ya existen: la barra ejecuta `rdpm status` cada 3 s
[ -d "$CONFIG_DIR" ] && [ -d "$STATE_DIR" ] || mkdir -p "$CONFIG_DIR" "$STATE_DIR"
[ -f "$DB" ] || echo '[]' > "$DB"

# --- utilidades -------------------------------------------------------------

err() { gum style --foreground 1 "✗ $*" >&2; }
warn() { gum style --foreground 3 "$@"; }
info() { gum style --foreground 2 "$*"; }
pause() { read -rsp "$(gum style --foreground 8 'Pulsa Enter para continuar…')"; echo; }
# Desde el menú, `die` sale de un subshell y el menú se redibuja: esperar para que se lea el error
die() { err "$@"; [ -z "$IN_MENU" ] || pause; exit 1; }
banner() { clear; gum style --bold --foreground 4 --border rounded --padding "0 2" "$1"; }

# Omarchy solo exporta los colores de gum (GUM_*, BACKGROUND…) al iniciar sesión, así que
# tras cambiar de tema el entorno trae los del anterior. omarchy-restart-gum carga los del
# tema actual, y los fondos iguales al del tema se quitan para usar el de la terminal, que
# Omarchy actualiza en caliente.
gum_theme_load() {
  command -v omarchy-restart-gum >/dev/null || return 0
  source omarchy-restart-gum
  local var bg="${BACKGROUND:-}"
  for var in $(compgen -e); do
    case "$var" in BACKGROUND|*_BACKGROUND) [ "${!var}" = "$bg" ] && unset "$var" ;; esac
  done
}

expand_path() { case "$1" in "~") echo "$HOME" ;; "~/"*) echo "$HOME/${1#\~/}" ;; *) echo "$1" ;; esac; }

# Función jq `addr`: "[dominio\]usuario@host" de una máquina
JQ_ADDR='def addr: (if (.domain // "") != "" then .domain + "\\" else "" end) + (.user // "") + "@" + (.host // "");'

# machine_load <nombre>: carga host, port, user, domain y share en las variables del llamador
machine_load() {
  local -a f
  mapfile -t -d '' f < <(jq --raw-output0 --arg n "$1" \
    'first(.[] | select(.name == $n)) | (.host, .port, .user, .domain, .share) | . // ""' "$DB")
  [ ${#f[@]} -eq 5 ] || return 1
  host="${f[0]}" port="${f[1]}" user="${f[2]}" domain="${f[3]}" share="${f[4]}"
}
machine_exists() { jq -e --arg n "$1" 'any(.[]; .name == $n)' "$DB" >/dev/null; }

db_write() { # db_write <filtro jq> [args jq...]; termina con error si no puede guardar
  local filter="$1"; shift
  local target; target="$(readlink -f -- "$DB")"
  local tmp; tmp="$(mktemp "$target.XXXX")" || die "No se pudo guardar $DB"
  jq "$@" "$filter" "$target" > "$tmp" && chmod --reference="$target" "$tmp" && mv "$tmp" "$target" && return
  rm -f "$tmp"
  die "No se pudo guardar $DB"
}

secret_get() { secret-tool lookup service "$KEYRING_SERVICE" machine "$1" 2>/dev/null; }
secret_set() { printf '%s' "$2" | secret-tool store --label="RDP: $1" service "$KEYRING_SERVICE" machine "$1"; }
secret_del() { secret-tool clear service "$KEYRING_SERVICE" machine "$1" 2>/dev/null || true; }

# --- alta / edición / baja --------------------------------------------------

machine_form() { # machine_form [nombre existente]
  local old="${1:-}" name host="" port="" user="" domain="" share="" password prev=""
  if [ -n "$old" ]; then machine_load "$old" || die "No existe la máquina '$old'"; fi

  name="$(gum input --header "Nombre (alias)" --placeholder "oficina" --value "$old")" || return 1
  [ -n "$name" ] || die "El nombre no puede estar vacío"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "Usa solo letras, números, punto, guion o guion bajo (empezando por letra o número)"
  if [ "$name" != "$old" ] && machine_exists "$name"; then die "Ya existe una máquina llamada '$name'"; fi

  host="$(gum input --header "Host o IP" --placeholder "192.168.1.10" --value "$host")" || return 1
  [ -n "$host" ] || die "El host no puede estar vacío"
  port="$(gum input --header "Puerto" --value "${port:-3389}")" || return 1
  [[ "$port" =~ ^[0-9]+$ ]] || die "Puerto inválido"
  domain="$(gum input --header "Dominio (vacío si no hay)" --placeholder "EMPRESA" --value "$domain")" || return 1
  user="$(gum input --header "Usuario" --value "$user")" || return 1
  share="$(gum input --header "Carpeta de Linux a compartir con Windows (vacío = no compartir)" \
    --placeholder "~/RDP" --value "$share")" || return 1
  [ "$share" = / ] || share="${share%/}"
  [[ "$share" != *,* ]] || die "La ruta de la carpeta no puede contener comas"
  if [ -n "$share" ]; then
    [[ "$share" == /* || "$share" == "~" || "$share" == "~/"* ]] || die "La carpeta debe ser una ruta absoluta o empezar por ~/"
    local share_real home_real
    share_real="$(realpath -m -- "$(expand_path "$share")")"
    home_real="$(realpath -m -- "$HOME")"
    if [[ "$home_real/" == "${share_real%/}/"* ]]; then
      gum confirm "Esa carpeta contiene tu home entero: expone claves SSH, tokens y demás configuración a Windows. ¿Seguro?" \
        --affirmative "Sí, compartir" --negative "Cambiar" --default=false || return 1
    fi
  fi

  local pw_header="Contraseña (vacío = preguntar al conectar)"
  [ -n "$old" ] && prev="$(secret_get "$old")"
  [ -n "$prev" ] && pw_header="Contraseña (vacío = mantener la actual)"
  password="$(gum input --password --header "$pw_header")" || return 1

  local entry
  entry="$(jq -n --arg name "$name" --arg host "$host" --argjson port "$port" \
    --arg user "$user" --arg domain "$domain" --arg share "$share" \
    '{name: $name, host: $host, port: $port, user: $user, domain: $domain, share: $share}')" ||
    die "No se pudieron preparar los datos de la máquina"

  if [ -n "$old" ]; then
    db_write 'map(if .name == $old then $e else . end)' --arg old "$old" --argjson e "$entry"
    if [ "$name" != "$old" ]; then
      if [ -n "$prev" ] && [ -z "$password" ]; then
        secret_set "$name" "$prev" || die "No se pudo mover la contraseña en el llavero"
      fi
      secret_del "$old"
      [ "$(cat "$LAST" 2>/dev/null)" = "$old" ] && echo "$name" > "$LAST"
    fi
  else
    db_write '. + [$e]' --argjson e "$entry"
  fi

  if [ -n "$password" ]; then
    secret_set "$name" "$password" || die "La máquina se guardó, pero no la contraseña (¿llavero activo?)"
  fi
  info "✓ Máquina '$name' guardada"
}

machine_remove() {
  local name="$1"
  machine_exists "$name" || die "No existe la máquina '$name'"
  gum confirm "¿Eliminar '$name' y su contraseña guardada?" --affirmative "Eliminar" --negative "Cancelar" || return 0
  db_write 'map(select(.name != $n))' --arg n "$name"
  secret_del "$name"
  info "✓ Máquina '$name' eliminada"
}

# --- conexión ---------------------------------------------------------------

connect() {
  local name="$1" host port user domain share password saved=1
  machine_load "$name" || die "No existe la máquina '$name'"

  local existing
  existing="$(sessions_list | awk -F'\t' -v n="$name" '$3 == n { print $1; exit }')"
  if [ -n "$existing" ]; then
    session_focus "$existing"
    return 0
  fi

  password="$(secret_get "$name")"
  if [ -z "$user" ]; then
    user="$(gum input --header "Usuario para $name")" || return 1
    db_write 'map(if .name == $n then .user = $u else . end)' --arg n "$name" --arg u "$user"
  fi
  local addr="${domain:+$domain\\}$user@$host"
  if [ -z "$password" ]; then
    saved=0
    password="$(gum input --password --header "Contraseña de $addr")" || return 1
  fi

  echo "$name" > "$LAST"
  local log="$STATE_DIR/$name.log"
  gum style --foreground 4 "󰢹 Conectando a $name ($addr:$port)…"

  # Los argumentos (incluida la contraseña) van por stdin, no aparecen en `ps`
  local args=(
    "/v:$host:$port"
    "/u:$user"
    "/p:$password"
    "/cert:tofu"
    "/auth-pkg-list:none,ntlm"
    "/title:$name"
    "/dynamic-resolution"
    "/size:1920x1080"
    "/gfx:AVC444"
    "/network:auto"
    "/sound:sys:pulse"
    "/microphone:sys:pulse"
    "+clipboard"
    "+auto-reconnect"
  )
  [ -n "$domain" ] && args+=("/d:$domain")
  if [ -n "$share" ]; then
    # En Windows aparece como "<carpeta> en <este equipo>", también en \\tsclient\<carpeta>
    local share_path; share_path="$(expand_path "$share")"
    mkdir -p "$share_path"
    args+=("/drive:$(basename "$share_path"),$share_path")
  fi

  # setsid: la sesión sobrevive al cierre de la terminal
  printf '%s\n' "${args[@]}" | setsid xfreerdp3 /args-from:stdin > "$log" 2>&1 &
  local pid=$!

  # Esperar a que aparezca la ventana o a que el proceso falle
  local i
  for ((i = 0; i < 60; i++)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      wait "$pid"; local rc=$?
      err "La conexión falló (código $rc):"
      grep -E 'ERRCONNECT|ERRINFO|LOGON|failed|error' "$log" | grep -v Kerberos | tail -5 | sed 's/^\[[^]]*\] \[[^]]*\] //'
      if grep -q LOGON_FAILURE "$log" && [ "$saved" -eq 1 ]; then
        warn "La contraseña guardada parece incorrecta. Edita la máquina para cambiarla."
      fi
      if grep -q 'IDENTIFICATION HAS CHANGED' "$log"; then
        warn "El certificado del servidor cambió. Si es esperado (Windows lo renueva), borra" \
          "${XDG_CONFIG_HOME:-$HOME/.config}/freerdp/server/${host,,}_$port.pem y vuelve a conectar."
      fi
      pause
      return 1
    fi
    sessions_list | awk -F'\t' -v p="$pid" -v n="$name" '$2 == p || $3 == n { f = 1 } END { exit !f }' && break
    sleep 0.5
  done

  if ((i == 60)); then
    warn "No apareció la ventana de $name; FreeRDP sigue intentando conectar (log: $log)."
    pause
    return 0
  fi

  if [ "$saved" -eq 0 ] && gum confirm "Conectado. ¿Guardar la contraseña en el llavero?" --affirmative "Guardar" --negative "No"; then
    secret_set "$name" "$password" && info "✓ Contraseña guardada"
  fi
  return 0 # conectado, aunque no se haya podido guardar la contraseña
}

# --- sesiones activas -------------------------------------------------------

# Una línea por ventana de FreeRDP: address \t pid \t título \t workspace
sessions_list() {
  hyprctl clients -j 2>/dev/null |
    jq -r '.[] | select(.class | test("freerdp"; "i")) | [.address, .pid, .title, .workspace.name] | @tsv'
}

session_focus() {
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null
}

session_disconnect() { # session_disconnect <pid> <título>
  if ! [[ "$1" =~ ^[0-9]+$ ]] || [ "$1" -le 1 ]; then
    err "PID inválido para '$2': no se desconecta"
    return 1
  fi
  # SIGTERM hace que FreeRDP se desconecte limpiamente; la sesión sigue viva en Windows
  kill -TERM "$1" 2>/dev/null
  local i
  for ((i = 0; i < 20; i++)); do kill -0 "$1" 2>/dev/null || break; sleep 0.25; done
  kill -0 "$1" 2>/dev/null && kill -KILL "$1" 2>/dev/null
  info "✓ '$2' desconectada"
}

sessions_menu() {
  while true; do
    banner "󰍹  Sesiones activas"

    local options=() address pid title ws
    while IFS=$'\t' read -r address pid title ws; do
      options+=("󰢹  $title  —  workspace $ws"$'\t'"$address|$pid|$title")
    done < <(sessions_list)

    if [ ${#options[@]} -eq 0 ]; then
      gum style --foreground 8 "No hay sesiones abiertas."
      sleep 1.5
      return 0
    fi
    [ ${#options[@]} -gt 1 ] && options+=("󰅖  Desconectar todas"$'\t'"all")
    options+=("  Volver"$'\t'"back")

    local choice
    choice="$(gum choose --header "Elige una sesión" --label-delimiter=$'\t' --height 15 "${options[@]}")" || return 0

    case "$choice" in
      back) return 0 ;;
      all)
        gum confirm "¿Desconectar todas las sesiones?" --affirmative "Desconectar" --negative "Cancelar" || continue
        # En paralelo: cada una puede tardar hasta 5 s en cerrarse
        while IFS=$'\t' read -r address pid title ws; do session_disconnect "$pid" "$title" & done < <(sessions_list)
        wait
        sleep 1
        ;;
      *)
        IFS='|' read -r address pid title <<< "$choice"
        local action
        action="$(gum choose --header "$title" --label-delimiter=$'\t' \
          "  Ir a la ventana"$'\t'"focus" \
          "󰅖  Desconectar (la sesión sigue abierta en Windows)"$'\t'"disconnect" \
          "  Volver"$'\t'"back")" || continue
        case "$action" in
          focus) session_focus "$address"; exit 0 ;;
          disconnect) session_disconnect "$pid" "$title"; sleep 1 ;;
        esac
        ;;
    esac
  done
}

# Salida JSON para el módulo de la barra
bar_status() {
  sessions_list | jq -Rnc --arg h "Clic: máquinas · Clic derecho: última · Clic central: sesiones" \
    '[inputs | split("\t")[2]] | if length > 0
      then {text: "󰢹 \(length)", tooltip: "Sesiones activas: \(join(", "))\n\($h)", class: "active"}
      else {text: "󰢹", tooltip: "Escritorio remoto\n\($h)", class: ""} end'
}

# --- menú -------------------------------------------------------------------

menu() {
  IN_MENU=1
  while true; do
    banner "󰢹  Escritorio remoto"

    local options=() names=() sessions name label
    mapfile -t sessions < <(sessions_list)
    [ ${#sessions[@]} -gt 0 ] && options+=("󰍹  Sesiones activas (${#sessions[@]})"$'\t'"sessions")
    while IFS=$'\t' read -r name label; do
      names+=("$name")
      options+=("$label"$'\t'"connect:$name")
    done < <(jq -r "$JQ_ADDR"' .[] | "\(.name)\t󰢹  \(.name)  —  \(addr)"' "$DB")
    options+=(" Añadir máquina"$'\t'"add")
    [ ${#names[@]} -gt 0 ] && options+=(" Editar máquina"$'\t'"edit" " Eliminar máquina"$'\t'"remove")
    options+=("  Salir"$'\t'"quit")

    local choice
    choice="$(gum choose --header "Elige una máquina" --label-delimiter=$'\t' --height 15 "${options[@]}")" || exit 0

    case "$choice" in
      connect:*) connect "${choice#connect:}" && exit 0 ;;
      sessions) sessions_menu ;;
      # En subshell: un `die` muestra el error y vuelve al menú en vez de cerrar la terminal
      add) ( machine_form ) ;;
      edit|remove)
        local target
        target="$(gum choose --header "¿Qué máquina?" "${names[@]}")" || continue
        if [ "$choice" = edit ]; then ( machine_form "$target" ); else ( machine_remove "$target" ); fi
        ;;
      quit) exit 0 ;;
    esac
  done
}

# --- entrada ----------------------------------------------------------------

# `status` no usa gum y la barra lo ejecuta cada 3 s
[ "${1:-}" = status ] || gum_theme_load

case "${1:-}" in
  "") menu ;;
  connect) connect "${2:?Falta el nombre}" ;;
  last)
    last="$(cat "$LAST" 2>/dev/null)"
    if [ -n "$last" ] && machine_exists "$last"; then connect "$last"; else menu; fi
    ;;
  sessions) sessions_menu ;;
  status) bar_status ;;
  add) machine_form ;;
  edit) machine_form "${2:?Falta el nombre}" ;;
  remove) machine_remove "${2:?Falta el nombre}" ;;
  list) jq -r "$JQ_ADDR"' .[] | "\(.name)\t\(addr):\(.port)\t\(if (.share // "") != "" then "comparte " + .share else "sin carpeta compartida" end)"' "$DB" | column -t -s $'\t' ;;
  *) echo "Uso: rdpm [connect <nombre> | last | sessions | status | add | edit <nombre> | remove <nombre> | list]" >&2; exit 1 ;;
esac
